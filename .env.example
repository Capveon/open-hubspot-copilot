# Never commit the real keys.

# Live glass coach. openai = gpt-4.1.
COACH_PROVIDER=openai
COACH_MODEL=gpt-4.1
OPENAI_API_KEY=

# Optional faster benches. Live desk does not need these.
INCEPTION_API_KEY=
INCEPTION_BASE_URL=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Wordmark + opener. Inlined at `next build`.
NEXT_PUBLIC_APP_NAME=Capveon
NEXT_PUBLIC_PRODUCT=Copilot
NEXT_PUBLIC_REP_NAME=Finn

# Clerk. Laptop = Development instance. Add http://localhost:3210 as an allowed origin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# HubSpot private app. Falls back to ~/.hscli/config.yml if unset.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# Optional overlays when a HubSpot record has no phone (test queues).
OHC_TEST_EMAIL=
OHC_TEST_PHONE=
OHC_BRISON_EMAIL=
OHC_BRISON_PHONE=

# Postgres. Schema defaults to ohc.
DATABASE_URL=postgres://user:pass@localhost:5432/copilot
DATABASE_ADMIN_URL=
OHC_DB_SCHEMA=ohc

# Twilio Voice. Off until you set OHC_ALLOW_PSTN=true.
# TwiML app Voice URL = https://<host>/api/twilio/voice
OHC_ALLOW_PSTN=false
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
OHC_PUBLIC_URL=
OHC_STT_HINTS=
